<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="principal.master.cs" Inherits="FACTURACION.LOGIN.principal" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=1280, initial-scale=1.0"/>
    <title>Sistema de Facturacion</title>
    <link rel="shortcut icon" type="image/x-icon" href="/IMAGENES/Favicon.png"/>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div id="contenedorApp">
            <div id="cabecera">
                <div id="contenidoCabecera">
                    <div id="barraHorizontal">
                        <ul>
                            <li><a href="/Default.aspx">Inicio</a></li>
                            <li><a href="/mantenimiento/deafaultmantenimiento.aspx">Mantenimiento</a></li>
                            <li><a href="/mantenimiento/frmempresa.aspx">Operaciones</a></li>
                            <li><a href="/mantenimiento/frmempresa.aspx">Reportes</a></li>
                            <li><a href="/mantenimiento/frmempresa.aspx">Seguridad</a></li>
                            <li><a href="/mantenimiento/frmempresa.aspx">Utilitarios</a></li>
                            <li><a href="/mantenimiento/frmempresa.aspx">Ayuda</a></li>
                        </ul>
                    </div>

                    <div id="logotipo">
                        <%--Llamar imagen de la Base de datos--%>
                        <div class="row">
                            <asp:Repeater ID="Repeater1" runat="server">
                                <ItemTemplate>
                                    <div class="col-md-4">
                                        <img class="img-responsive" src="data:image/jpg;base64,<%# Convert.ToBase64String((byte[])DataBinder.Eval(Container.DataItem, "Emp_Logo"))%>" />
                                        <br />
                                    </div>
                                </ItemTemplate>
                            </asp:Repeater>
                        </div>
                    </div>

                    <div id="titulo">
                        <h1>Sistema de Facturacion Electronica</h1>
                    </div>
                </div>
            </div>

            <div id="bajo">
                <div id="columnIzq">
                    <asp:ContentPlaceHolder ID="contenidoMenuContextual" runat="server">
                    </asp:ContentPlaceHolder>
                </div>

                <div id="columnCentro">
                    <asp:ContentPlaceHolder ID="contenidoPrincipal" runat="server">
                    </asp:ContentPlaceHolder>
                </div>

                <div id="columnDer">
                </div>

                <div id="pie">
                    <span id="copy">&nbsp;&nbsp;&nbsp;&nbsp;Copyright &copy; 2026 / Version: 1.0</span>
                </div>
            </div>
        </div>
    </form>
</body>
</html>
